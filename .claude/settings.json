{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*figma.*__(use_figma|create_new_file|upload_assets)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/pre-figma-call.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*figma.*__(use_figma|create_new_file|upload_assets)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/post-figma-call.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*figma.*__(use_figma|create_new_file|upload_assets)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/post-figma-call.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
