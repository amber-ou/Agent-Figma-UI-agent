{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figma-ui.local/schemas/common.schema.json",
  "title": "figma-ui shared definitions (spec v1.6 §20)",
  "$defs": {
    "schemaVersion": {
      "const": "1.2"
    },
    "runId": {
      "description": "Run identifier; also a directory name under design-runs/.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "realId": {
      "description": "Identifier taken from a real run. Angle-bracket placeholders such as <node-id> are rejected (spec §20).",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^<>]+$"
    },
    "localId": {
      "description": "Local record id (decision, pattern, evidence, operation, finding, ...).",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "fileKey": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]{22,128}$"
    },
    "nodeId": {
      "description": "Figma node id, including instance-sublayer ids such as I1:2;3:4.",
      "type": "string",
      "pattern": "^I?[0-9]+:[0-9]+(;[0-9]+:[0-9]+)*$"
    },
    "libraryKey": {
      "type": "string",
      "pattern": "^lk-[0-9a-f]{16,}$"
    },
    "assetKey": {
      "description": "Component, component set, style or variable key.",
      "type": "string",
      "pattern": "^[0-9a-f]{16,64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullableDateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "taskType": {
      "enum": [
        "extend",
        "modify",
        "audit"
      ]
    },
    "workflow": {
      "enum": [
        "native_design",
        "capture_and_reconcile",
        "design_to_code"
      ]
    },
    "runStatus": {
      "enum": [
        "in_progress",
        "complete",
        "complete_with_exceptions",
        "awaiting_user",
        "blocked",
        "partial"
      ]
    },
    "phase": {
      "enum": [
        "intake",
        "preflight",
        "discover",
        "plan",
        "build",
        "validate",
        "handoff",
        "reconcile"
      ]
    },
    "operationStatus": {
      "enum": [
        "planned",
        "dispatched",
        "applied",
        "verified",
        "failed_known",
        "unknown_outcome",
        "cancelled"
      ]
    },
    "operationMode": {
      "enum": [
        "read",
        "write"
      ]
    },
    "gateStatus": {
      "enum": [
        "pass",
        "fail",
        "not_applicable",
        "not_verified"
      ]
    },
    "capabilityStatus": {
      "enum": [
        "available_unverified",
        "verified",
        "unavailable",
        "denied",
        "unknown"
      ]
    },
    "coverage": {
      "enum": [
        "complete_for_requested_scope",
        "partial",
        "unavailable"
      ]
    },
    "decisionSource": {
      "enum": [
        "user",
        "ds",
        "existing_pattern",
        "brief",
        "product_policy"
      ]
    },
    "rowConfirmation": {
      "description": "v1.7/v1.8 DEC-09: how the user confirmed a prefilled list row (user_skipped: the user explicitly skipped it, v1.8)",
      "enum": [
        "prefilled_confirmed",
        "user_modified",
        "user_filled",
        "user_skipped"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "major",
        "minor"
      ]
    },
    "findingStatus": {
      "enum": [
        "open",
        "resolved",
        "accepted"
      ]
    },
    "findingOrigin": {
      "enum": [
        "introduced",
        "regression",
        "inherited_baseline"
      ]
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localId"
      },
      "uniqueItems": true
    },
    "nodeIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeId"
      },
      "uniqueItems": true
    },
    "policyRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*#(policies/accessibility.contrast|rules/[a-z0-9][a-z0-9-]*)$",
      "description": "v1.7 §7.5: <productId>#policies/<item> or <productId>#rules/<id>; must resolve in product-policies/<productId>.json"
    },
    "decisionKind": {
      "description": "v1.9 DEC-12/13: what a design decision is about. direction = a bundled direction proposal (DEC-13); size, spacing, alignment, component_width and placeholder_size are the kinds a run may delegate (DEC-12).",
      "enum": [
        "direction",
        "size",
        "spacing",
        "alignment",
        "component_width",
        "placeholder_size",
        "other"
      ]
    },
    "delegableKind": {
      "description": "v1.9 DEC-12: the only kinds a scoped delegation may allow.",
      "enum": [
        "size",
        "spacing",
        "alignment",
        "component_width",
        "placeholder_size"
      ]
    },
    "excludedTopic": {
      "description": "v1.9 DEC-12/13: topics that are never delegated and never bundled into a direction proposal (copy, brand assets, external requirements, new tokens or components, raw-value exceptions, platform, write scope).",
      "enum": [
        "copy",
        "brand_asset",
        "external_requirement",
        "new_token",
        "new_component",
        "raw_value_exception",
        "platform",
        "write_scope"
      ]
    }
  }
}
