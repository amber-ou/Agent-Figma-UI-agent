{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figma-ui.local/schemas/capabilities.schema.json",
  "title": "capabilities.json (spec §4.2.1, §5.1, §20)",
  "type": "object",
  "required": ["schemaVersion", "runId", "runtime", "server", "tools", "features", "checkedAt"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "runId": { "$ref": "common.schema.json#/$defs/runId" },
    "runtime": {
      "type": "object",
      "required": ["claudeCodeVersion"],
      "properties": {
        "claudeCodeVersion": { "type": "string" },
        "os": { "type": "string" },
        "node": { "type": "string" },
        "figmaPlugin": {
          "type": "object",
          "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "skills": { "type": "array", "items": { "type": "string" } } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "required": ["name", "url", "toolPrefix"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "transport": { "type": "string" },
        "toolPrefix": { "type": "string", "pattern": "^mcp__.+__$" },
        "health": { "type": "string" }
      },
      "additionalProperties": false
    },
    "account": {
      "description": "CAP-03 / §4.2.1: plan references and seat only. No email or handle.",
      "type": "object",
      "required": ["status", "plans"],
      "properties": {
        "status": { "enum": ["ok", "blocked"] },
        "plans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["planRef", "seat"],
            "properties": {
              "planRef": { "type": "string" },
              "tier": { "type": "string" },
              "seat": { "enum": ["Full", "Dev", "Collab", "View"] },
              "role": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "targetPlanRef": { "type": ["string", "null"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "recoverySteps": { "type": "array", "items": { "type": "string" } },
        "checkedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "pattern": "^mcp__.+__.+$" },
          "status": { "$ref": "common.schema.json#/$defs/capabilityStatus" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "common.schema.json#/$defs/capabilityStatus" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "value": {},
          "notes": { "type": "string" },
          "checkedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
          "basis": {
            "description": "v1.6 (A06): this_run = a call in this run succeeded; history = carried over from runtime-probes.md or an earlier run. A history result is never verified for this run.",
            "enum": ["this_run", "history"]
          }
        },
        "additionalProperties": false,
        "allOf": [
          { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } } },
          { "if": { "required": ["basis"], "properties": { "basis": { "const": "history" } } }, "then": { "properties": { "status": { "not": { "const": "verified" } } } } }
        ]
      }
    },
    "environmentDiagnosis": {
      "description": "v1.6 (A06): the installation diagnosis this run relied on (verify-installation.mjs). It is separate from this run's account, file and tool checks, which are always done per run.",
      "type": "object",
      "required": ["mode", "checkedAt"],
      "properties": {
        "mode": { "enum": ["full", "reused"] },
        "reason": { "type": "string" },
        "checkedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "cachedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "fingerprintDigest": { "type": "string" },
        "problems": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "useFigmaReturnBytes": {
          "description": "v1.6: the use_figma response limit in UTF-8 bytes (20,480 measured in M2/M3).",
          "type": "object",
          "properties": {
            "status": { "$ref": "common.schema.json#/$defs/capabilityStatus" },
            "maxObservedOk": { "type": ["integer", "null"] },
            "firstFailure": { "type": ["integer", "null"] },
            "behaviourAboveLimit": { "type": "string" },
            "evidence": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "useFigmaReturnChars": {
          "description": "Deprecated (v1.4 name, kept for old capabilities files): the limit is counted in UTF-8 bytes, use useFigmaReturnBytes.",
          "type": "object",
          "properties": {
            "status": { "$ref": "common.schema.json#/$defs/capabilityStatus" },
            "maxObservedOk": { "type": ["integer", "null"] },
            "firstFailure": { "type": ["integer", "null"] },
            "behaviourAboveLimit": { "type": "string" },
            "evidence": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "getMetadataWholePage": { "type": "object" },
        "searchDesignSystemQueriesPerCall": { "type": ["integer", "null"] }
      }
    },
    "unverified": { "type": "array", "items": { "type": "string" } },
    "checkedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  },
  "additionalProperties": false
}
