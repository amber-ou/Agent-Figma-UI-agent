{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figma-ui.local/schemas/plan.schema.json",
  "title": "plan.json (spec §6.2, §6.3, §7.4, §8, §20)",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "taskType",
    "status",
    "screens",
    "requiredCells",
    "componentMap",
    "variableMap",
    "patternRefs",
    "designDecisions",
    "scope",
    "baseline",
    "decisions"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/runId"
    },
    "taskType": {
      "$ref": "common.schema.json#/$defs/taskType"
    },
    "status": {
      "enum": [
        "draft",
        "confirmed"
      ]
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "screenKey"
        ],
        "properties": {
          "screenKey": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "task": {
            "type": "string"
          },
          "primaryAction": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "patternRefs": {
            "$ref": "common.schema.json#/$defs/refs"
          },
          "decisionRefs": {
            "$ref": "common.schema.json#/$defs/refs"
          },
          "contentLimits": {
            "type": "object"
          },
          "destinations": {
            "type": "object"
          },
          "copy": {
            "description": "v1.6 (A04): the real text this screen shows. Build uses confirmed copy only; pending copy blocks the Build boundary.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "role",
                "text",
                "status"
              ],
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/localId"
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "confirmed",
                    "pending"
                  ]
                },
                "sourceRef": {
                  "type": "string"
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1
                },
                "origin": {
                  "description": "v1.9 DEC-14: existing = formal copy from a source screen or document (sourceRef); user = text the user wrote in the request or an answer (sourceRef); draft = agent draft, marked 擬稿 and listed for confirmation. A confirmed draft keeps origin draft.",
                  "enum": [
                    "existing",
                    "user",
                    "draft"
                  ]
                },
                "decisionRef": {
                  "description": "v1.9 DEC-14: the decision in which the user confirmed this text (required for a confirmed draft).",
                  "$ref": "common.schema.json#/$defs/localId"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "description": "v1.9 DEC-14: existing and user copy name their source",
                  "if": {
                    "required": [
                      "origin"
                    ],
                    "properties": {
                      "origin": {
                        "enum": [
                          "existing",
                          "user"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "sourceRef"
                    ]
                  }
                },
                {
                  "description": "v1.9 DEC-14 / INVARIANT-30: a draft is confirmed only through a user decision",
                  "if": {
                    "required": [
                      "origin",
                      "status"
                    ],
                    "properties": {
                      "origin": {
                        "const": "draft"
                      },
                      "status": {
                        "const": "confirmed"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "decisionRef"
                    ]
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "requiredCells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "screenKey",
          "applicable",
          "evidence",
          "deliverable"
        ],
        "properties": {
          "key": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "screenKey": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "checkId": {
            "type": "string"
          },
          "viewport": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "enum": [
                "structure",
                "screenshot",
                "contrast",
                "check"
              ]
            },
            "uniqueItems": true
          },
          "deliverable": {
            "enum": [
              "frame",
              "variant",
              "annotation",
              "report"
            ]
          },
          "decisionRef": {
            "$ref": "common.schema.json#/$defs/localId"
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "applicable": {
              "const": false
            }
          }
        },
        "then": {
          "required": [
            "reason"
          ]
        }
      }
    },
    "componentMap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "logicalName",
          "source",
          "decision",
          "reason"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "logicalName": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "published_library",
                  "local",
                  "remote_instance"
                ]
              },
              "libraryKey": {
                "$ref": "common.schema.json#/$defs/libraryKey"
              },
              "sourceFileKey": {
                "$ref": "common.schema.json#/$defs/fileKey"
              },
              "sourceNodeId": {
                "$ref": "common.schema.json#/$defs/nodeId"
              },
              "componentKey": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "common.schema.json#/$defs/assetKey"
                  }
                ]
              },
              "componentSetKey": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "common.schema.json#/$defs/assetKey"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "supportedVariants": {
            "type": "object"
          },
          "textPropertyKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instanceSwapPropertyKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredStateGaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision": {
            "enum": [
              "reuse",
              "wrap_proposed",
              "new_proposed",
              "blocked",
              "awaiting_user"
            ]
          },
          "reason": {
            "type": "string"
          },
          "versionCheck": {
            "description": "v1.3 §6.2: current published version vs the version used by existing screens.",
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "same",
                  "differs",
                  "not_checked"
                ]
              },
              "differences": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "baselineRef": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "listedToUserRef": {
                "$ref": "common.schema.json#/$defs/localId"
              }
            },
            "additionalProperties": false,
            "if": {
              "properties": {
                "status": {
                  "const": "differs"
                }
              }
            },
            "then": {
              "required": [
                "differences",
                "baselineRef"
              ]
            }
          },
          "evidenceRefs": {
            "$ref": "common.schema.json#/$defs/refs"
          }
        },
        "additionalProperties": false
      }
    },
    "variableMap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "usage",
          "property",
          "name",
          "resolvedType",
          "sourceKind",
          "bindingStatus"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "usage": {
            "type": "string"
          },
          "property": {
            "type": "string"
          },
          "variableId": {
            "$ref": "common.schema.json#/$defs/realId"
          },
          "variableKey": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/assetKey"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "collectionKey": {
            "$ref": "common.schema.json#/$defs/assetKey"
          },
          "collectionName": {
            "type": "string"
          },
          "resolvedType": {
            "enum": [
              "COLOR",
              "FLOAT",
              "STRING",
              "BOOLEAN"
            ]
          },
          "sourceKind": {
            "enum": [
              "local",
              "remote"
            ]
          },
          "libraryKey": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/libraryKey"
              }
            ]
          },
          "modeSelection": {
            "type": "object"
          },
          "aliasChain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consumerNodeId": {
            "$ref": "common.schema.json#/$defs/nodeId"
          },
          "resolutionMethod": {
            "enum": [
              "runtime",
              "manual_trace",
              "none"
            ]
          },
          "valueStatus": {
            "enum": [
              "verified",
              "unresolved",
              "unavailable"
            ]
          },
          "traceStatus": {
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "bindingStatus": {
            "enum": [
              "verified",
              "planned",
              "inherited_only",
              "gap",
              "not_verified"
            ]
          },
          "gapRef": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "evidenceRefs": {
            "$ref": "common.schema.json#/$defs/refs"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "bindingStatus": {
                  "const": "gap"
                }
              }
            },
            "then": {
              "required": [
                "gapRef"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "bindingStatus": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "required": [
                "variableKey",
                "consumerNodeId",
                "valueStatus"
              ],
              "properties": {
                "resolutionMethod": {
                  "const": "runtime"
                },
                "valueStatus": {
                  "const": "verified"
                }
              }
            }
          }
        ]
      }
    },
    "patternRefs": {
      "$ref": "common.schema.json#/$defs/refs"
    },
    "designDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "options",
          "recommendation",
          "answer",
          "source",
          "evidenceRefs",
          "decidedAt"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "common.schema.json#/$defs/decisionSource"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decidedAt": {
            "$ref": "common.schema.json#/$defs/nullableDateTime"
          },
          "status": {
            "description": "v1.4 DEC-08. Optional for older plans: absent means answered when answer is a string, else pending.",
            "enum": [
              "pending",
              "answered",
              "skipped"
            ]
          },
          "delegation": {
            "description": "v1.4 DEC-07: the user authorised adopting the agent's recommendation for this run only (INVARIANT-18).",
            "type": "object",
            "required": [
              "decisionRef",
              "scope",
              "runId"
            ],
            "properties": {
              "decisionRef": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "scope": {
                "const": "run"
              },
              "runId": {
                "$ref": "common.schema.json#/$defs/runId"
              }
            },
            "additionalProperties": false
          },
          "policyRef": {
            "$ref": "common.schema.json#/$defs/policyRef"
          },
          "confirmation": {
            "$ref": "common.schema.json#/$defs/rowConfirmation"
          },
          "skippedBy": {
            "description": "v1.8 DEC-08: who marked the decision skipped. user = the user saw the row and chose to skip it (resolved, INVARIANT-28); agent = marked before the user saw it (still open). Absent on a skipped decision means agent (records before v1.8).",
            "enum": [
              "user",
              "agent"
            ]
          },
          "kind": {
            "$ref": "common.schema.json#/$defs/decisionKind"
          },
          "topic": {
            "description": "v1.9 DEC-12/13: what the decision touches. The validator refuses a delegated decision or a direction sub-choice whose topic is excluded (copy, brand_asset, external_requirement, new_token, new_component, raw_value_exception, platform, write_scope).",
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/excludedTopic"
              },
              {
                "enum": [
                  "layout",
                  "visual",
                  "component_choice",
                  "detail",
                  "other"
                ]
              }
            ]
          },
          "directionRef": {
            "description": "v1.9 DEC-12 / INVARIANT-29: the confirmed kind:direction decision a delegated detail belongs to.",
            "$ref": "common.schema.json#/$defs/localId"
          },
          "dependsOn": {
            "description": "v1.9 DEC-13: the kind:direction decision this sub-choice is bundled with; it is confirmed together with the direction unless the user changes the direction.",
            "$ref": "common.schema.json#/$defs/localId"
          },
          "requirementRefs": {
            "description": "v1.9 EXT-01: inventory.externalRequirements this decision is constrained by.",
            "$ref": "common.schema.json#/$defs/refs"
          },
          "confirmedWith": {
            "description": "v1.9 DEC-13: how a direction sub-choice was confirmed. direction = accepted together with its direction proposal (not a separate substantive decision); row = asked and confirmed as its own row (required when the user changed the direction).",
            "enum": [
              "direction",
              "row"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "description": "v1.8 DEC-08: skippedBy only on skipped decisions",
            "if": {
              "required": [
                "skippedBy"
              ]
            },
            "then": {
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "const": "skipped"
                }
              }
            }
          },
          {
            "description": "v1.8 DEC-09: user_skipped is the user's explicit skip (skippedBy user)",
            "if": {
              "required": [
                "confirmation"
              ],
              "properties": {
                "confirmation": {
                  "const": "user_skipped"
                }
              }
            },
            "then": {
              "required": [
                "status",
                "skippedBy"
              ],
              "properties": {
                "status": {
                  "const": "skipped"
                },
                "skippedBy": {
                  "const": "user"
                }
              }
            }
          },
          {
            "description": "v1.8: a user skip is recorded with confirmation user_skipped",
            "if": {
              "required": [
                "skippedBy"
              ],
              "properties": {
                "skippedBy": {
                  "const": "user"
                }
              }
            },
            "then": {
              "required": [
                "confirmation"
              ],
              "properties": {
                "confirmation": {
                  "const": "user_skipped"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "answer": {
                  "type": "string"
                }
              }
            },
            "then": {
              "properties": {
                "decidedAt": {
                  "$ref": "common.schema.json#/$defs/dateTime"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "const": "answered"
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pending",
                    "skipped"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "null"
                }
              }
            }
          },
          {
            "description": "DEC-07: a delegated answer is the recommendation, recorded as a user decision; no recommendation means skipped, never delegated.",
            "if": {
              "required": [
                "delegation"
              ]
            },
            "then": {
              "required": [
                "status"
              ],
              "properties": {
                "source": {
                  "const": "user"
                },
                "status": {
                  "const": "answered"
                },
                "recommendation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "description": "v1.7 DEC-06: product_policy decisions need a resolvable policyRef",
            "if": {
              "required": [
                "source"
              ],
              "properties": {
                "source": {
                  "const": "product_policy"
                }
              }
            },
            "then": {
              "required": [
                "policyRef"
              ]
            }
          },
          {
            "description": "v1.9 DEC-13: a direction is the parent of sub-choices; it is not itself a sub-choice or a delegated detail.",
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "direction"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "dependsOn"
                    ]
                  },
                  {
                    "required": [
                      "directionRef"
                    ]
                  },
                  {
                    "required": [
                      "delegation"
                    ]
                  }
                ]
              }
            }
          },
          {
            "description": "v1.9 DEC-13: confirmedWith only on sub-choices of a direction",
            "if": {
              "required": [
                "confirmedWith"
              ]
            },
            "then": {
              "required": [
                "dependsOn"
              ]
            }
          }
        ]
      }
    },
    "undefinedBehaviors": {
      "description": "v1.8 DEC-11: dynamic behaviour that does not change the static screen (timing, dismissal, animation, transition, gesture). Never asked and never a designDecision; listed in the handoff as \"未定義，交由實作決定\".",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "behavior"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "behavior": {
            "type": "string",
            "minLength": 1,
            "description": "what the implementation has to decide, e.g. how long the toast stays"
          },
          "kind": {
            "enum": [
              "timing",
              "dismissal",
              "animation",
              "transition",
              "gesture",
              "other"
            ]
          },
          "screenKey": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "excludedSkillsLoaded": {
      "description": "v1.8 §4.7: an excluded skill that was loaded anyway (e.g. auto-loaded because the task mentions Figma). Its conflicting content is not adopted; the handoff lists it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "notAdopted"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "notAdopted": {
            "type": "string",
            "minLength": 1,
            "description": "what was not adopted and why"
          }
        },
        "additionalProperties": false
      }
    },
    "accessibilityPrecheck": {
      "description": "v1.4 §9.5: contrast / target-size check of the patterns and styles the plan will reuse, done before Build.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "subject",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "kind": {
            "enum": [
              "text_contrast",
              "non_text_contrast",
              "target_size"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "styleName": {
            "type": "string"
          },
          "sourceNodeIds": {
            "$ref": "common.schema.json#/$defs/nodeIds"
          },
          "foreground": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "background": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "fontSize": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bold": {
            "type": "boolean"
          },
          "ratio": {
            "type": "number",
            "minimum": 1
          },
          "required": {
            "type": "number",
            "minimum": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_verified"
            ]
          },
          "baselineRef": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "decisionRef": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "fail"
                }
              }
            },
            "then": {
              "required": [
                "decisionRef"
              ]
            }
          }
        ]
      }
    },
    "scope": {
      "type": "object"
    },
    "baseline": {
      "type": "object",
      "required": [
        "observations"
      ],
      "properties": {
        "pagesBefore": {
          "$ref": "common.schema.json#/$defs/nodeIds"
        },
        "screenshots": {
          "$ref": "common.schema.json#/$defs/refs"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "subject"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "kind": {
                "enum": [
                  "inherited_baseline",
                  "regression_risk",
                  "note"
                ]
              },
              "subject": {
                "type": "string"
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "flow": {
      "description": "v1.6 (A04): on-demand flow judgement. level=unchanged keeps the existing flow (reason says why no flow work is needed); partial adds the local steps that change; task_flow lays out the whole task. Unknown business rules stay as open unknowns and are never filled in by the agent.",
      "type": "object",
      "required": [
        "level",
        "reason",
        "sources",
        "status"
      ],
      "properties": {
        "level": {
          "enum": [
            "unchanged",
            "partial",
            "task_flow"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "description": "Where the flow comes from. Empty only for level=unchanged; never invent a source.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "brief",
                  "user",
                  "pattern",
                  "reference_node",
                  "decision"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "status": {
          "enum": [
            "pending",
            "confirmed"
          ]
        },
        "confirmedBy": {
          "description": "brief: the request itself fixes the flow (for example a local style change); user: needs decisionRef.",
          "enum": [
            "brief",
            "user"
          ]
        },
        "decisionRef": {
          "$ref": "common.schema.json#/$defs/localId"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "action",
              "result",
              "screenKey"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "entry": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              },
              "screenKey": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "branches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "condition",
                    "to"
                  ],
                  "properties": {
                    "condition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "$ref": "common.schema.json#/$defs/localId"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "end": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "status"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "open",
                  "answered"
                ]
              },
              "answer": {
                "type": "string"
              },
              "decisionRef": {
                "$ref": "common.schema.json#/$defs/localId"
              }
            },
            "additionalProperties": false,
            "if": {
              "properties": {
                "status": {
                  "const": "answered"
                }
              }
            },
            "then": {
              "required": [
                "answer",
                "decisionRef"
              ]
            }
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "enum": [
                  "partial",
                  "task_flow"
                ]
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ],
            "properties": {
              "steps": {
                "minItems": 1
              },
              "sources": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "confirmedBy"
            ],
            "properties": {
              "confirmedBy": {
                "const": "user"
              }
            }
          },
          "then": {
            "required": [
              "decisionRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "required": [
              "confirmedBy"
            ]
          }
        }
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision",
          "scope",
          "decidedAt",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "decision": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "decidedAt": {
            "$ref": "common.schema.json#/$defs/dateTime"
          },
          "source": {
            "enum": [
              "user"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "policyRef": {
            "$ref": "common.schema.json#/$defs/policyRef"
          },
          "runOnly": {
            "description": "v1.7 §4.6: a setting valid for this run only (test-round rule, DEC-07 delegation); never suggested or written as a product policy",
            "type": "boolean"
          },
          "confirmation": {
            "description": "v1.8 DEC-09: scope and authorisation rows of the prefilled list (product, platform, library, output, boundary, plan confirmation) record how the user confirmed them, like design decisions",
            "$ref": "common.schema.json#/$defs/rowConfirmation"
          },
          "policySuggestion": {
            "description": "v1.7 POL-05: a user preference that may apply to the whole product; listed in the handoff, written only if the user ticks it",
            "type": "object",
            "required": [
              "text",
              "appliesTo"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "appliesTo": {
                "enum": [
                  "design_decision",
                  "naming",
                  "brand",
                  "other",
                  "accessibility.contrast"
                ]
              },
              "value": {},
              "conflictsWith": {
                "$ref": "common.schema.json#/$defs/policyRef"
              }
            },
            "additionalProperties": false
          },
          "delegation": {
            "description": "v1.9 DEC-12: a scoped delegation, given once per run with the direction confirmation. Delegated design decisions must use an allowed kind, avoid every excluded topic and point at a confirmed direction (INVARIANT-29). scope must be \"run\"; never a product policy.",
            "type": "object",
            "required": [
              "allowedKinds",
              "excludedKinds"
            ],
            "properties": {
              "allowedKinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "common.schema.json#/$defs/delegableKind"
                }
              },
              "excludedKinds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "common.schema.json#/$defs/excludedTopic"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "description": "v1.9 DEC-12: a delegation is valid for this run only",
            "if": {
              "required": [
                "delegation"
              ]
            },
            "then": {
              "properties": {
                "scope": {
                  "const": "run"
                },
                "runOnly": {
                  "const": true
                }
              },
              "required": [
                "runOnly"
              ]
            }
          }
        ]
      }
    },
    "importChecks": {
      "description": "v1.9 §8.1 step 6b: before Plan, every component and style key the plan imports is checked in the output file. not_importable needs a fallback (the same style or instance already used on screen) listed in the plan.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "kind": {
            "enum": [
              "component",
              "component_set",
              "style"
            ]
          },
          "componentMapRef": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "styleName": {
            "type": "string"
          },
          "key": {
            "$ref": "common.schema.json#/$defs/assetKey"
          },
          "method": {
            "enum": [
              "import_by_key",
              "existing_instance",
              "existing_style_on_screen"
            ]
          },
          "status": {
            "enum": [
              "importable",
              "not_importable",
              "not_checked"
            ]
          },
          "fallback": {
            "type": "string",
            "minLength": 1
          },
          "listedToUserRef": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "evidenceRefs": {
            "$ref": "common.schema.json#/$defs/refs"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_importable"
                }
              }
            },
            "then": {
              "required": [
                "fallback"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "component",
                    "component_set"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "componentMapRef"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "style"
                }
              }
            },
            "then": {
              "required": [
                "styleName"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
