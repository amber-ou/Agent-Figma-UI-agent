{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figma-ui.local/schemas/plan.schema.json",
  "title": "plan.json (spec §6.2, §6.3, §7.4, §8, §20)",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "taskType",
    "status",
    "screens",
    "requiredCells",
    "componentMap",
    "variableMap",
    "patternRefs",
    "designDecisions",
    "scope",
    "baseline",
    "decisions"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/runId"
    },
    "taskType": {
      "$ref": "common.schema.json#/$defs/taskType"
    },
    "status": {
      "enum": [
        "draft",
        "confirmed"
      ]
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "screenKey"
        ],
        "properties": {
          "screenKey": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "task": {
            "type": "string"
          },
          "primaryAction": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "patternRefs": {
            "$ref": "common.schema.json#/$defs/refs"
          },
          "decisionRefs": {
            "$ref": "common.schema.json#/$defs/refs"
          },
          "contentLimits": {
            "type": "object"
          },
          "destinations": {
            "type": "object"
          },
          "copy": {
            "description": "v1.6 (A04): the real text this screen shows. Build uses confirmed copy only; pending copy blocks the Build boundary.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "role",
                "text",
                "status"
              ],
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/localId"
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "confirmed",
                    "pending"
                  ]
                },
                "sourceRef": {
                  "type": "string"
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "requiredCells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "screenKey",
          "applicable",
          "evidence",
          "deliverable"
        ],
        "properties": {
          "key": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "screenKey": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "checkId": {
            "type": "string"
          },
          "viewport": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "enum": [
                "structure",
                "screenshot",
                "contrast",
                "check"
              ]
            },
            "uniqueItems": true
          },
          "deliverable": {
            "enum": [
              "frame",
              "variant",
              "annotation",
              "report"
            ]
          },
          "decisionRef": {
            "$ref": "common.schema.json#/$defs/localId"
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "applicable": {
              "const": false
            }
          }
        },
        "then": {
          "required": [
            "reason"
          ]
        }
      }
    },
    "componentMap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "logicalName",
          "source",
          "decision",
          "reason"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "logicalName": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "published_library",
                  "local",
                  "remote_instance"
                ]
              },
              "libraryKey": {
                "$ref": "common.schema.json#/$defs/libraryKey"
              },
              "sourceFileKey": {
                "$ref": "common.schema.json#/$defs/fileKey"
              },
              "sourceNodeId": {
                "$ref": "common.schema.json#/$defs/nodeId"
              },
              "componentKey": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "common.schema.json#/$defs/assetKey"
                  }
                ]
              },
              "componentSetKey": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "common.schema.json#/$defs/assetKey"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "supportedVariants": {
            "type": "object"
          },
          "textPropertyKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instanceSwapPropertyKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredStateGaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision": {
            "enum": [
              "reuse",
              "wrap_proposed",
              "new_proposed",
              "blocked",
              "awaiting_user"
            ]
          },
          "reason": {
            "type": "string"
          },
          "versionCheck": {
            "description": "v1.3 §6.2: current published version vs the version used by existing screens.",
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "same",
                  "differs",
                  "not_checked"
                ]
              },
              "differences": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "baselineRef": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "listedToUserRef": {
                "$ref": "common.schema.json#/$defs/localId"
              }
            },
            "additionalProperties": false,
            "if": {
              "properties": {
                "status": {
                  "const": "differs"
                }
              }
            },
            "then": {
              "required": [
                "differences",
                "baselineRef"
              ]
            }
          },
          "evidenceRefs": {
            "$ref": "common.schema.json#/$defs/refs"
          }
        },
        "additionalProperties": false
      }
    },
    "variableMap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "usage",
          "property",
          "name",
          "resolvedType",
          "sourceKind",
          "bindingStatus"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "usage": {
            "type": "string"
          },
          "property": {
            "type": "string"
          },
          "variableId": {
            "$ref": "common.schema.json#/$defs/realId"
          },
          "variableKey": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/assetKey"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "collectionKey": {
            "$ref": "common.schema.json#/$defs/assetKey"
          },
          "collectionName": {
            "type": "string"
          },
          "resolvedType": {
            "enum": [
              "COLOR",
              "FLOAT",
              "STRING",
              "BOOLEAN"
            ]
          },
          "sourceKind": {
            "enum": [
              "local",
              "remote"
            ]
          },
          "libraryKey": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/libraryKey"
              }
            ]
          },
          "modeSelection": {
            "type": "object"
          },
          "aliasChain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consumerNodeId": {
            "$ref": "common.schema.json#/$defs/nodeId"
          },
          "resolutionMethod": {
            "enum": [
              "runtime",
              "manual_trace",
              "none"
            ]
          },
          "valueStatus": {
            "enum": [
              "verified",
              "unresolved",
              "unavailable"
            ]
          },
          "traceStatus": {
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "bindingStatus": {
            "enum": [
              "verified",
              "planned",
              "inherited_only",
              "gap",
              "not_verified"
            ]
          },
          "gapRef": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "evidenceRefs": {
            "$ref": "common.schema.json#/$defs/refs"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "bindingStatus": {
                  "const": "gap"
                }
              }
            },
            "then": {
              "required": [
                "gapRef"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "bindingStatus": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "required": [
                "variableKey",
                "consumerNodeId",
                "valueStatus"
              ],
              "properties": {
                "resolutionMethod": {
                  "const": "runtime"
                },
                "valueStatus": {
                  "const": "verified"
                }
              }
            }
          }
        ]
      }
    },
    "patternRefs": {
      "$ref": "common.schema.json#/$defs/refs"
    },
    "designDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "options",
          "recommendation",
          "answer",
          "source",
          "evidenceRefs",
          "decidedAt"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "common.schema.json#/$defs/decisionSource"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decidedAt": {
            "$ref": "common.schema.json#/$defs/nullableDateTime"
          },
          "status": {
            "description": "v1.4 DEC-08. Optional for older plans: absent means answered when answer is a string, else pending.",
            "enum": [
              "pending",
              "answered",
              "skipped"
            ]
          },
          "delegation": {
            "description": "v1.4 DEC-07: the user authorised adopting the agent's recommendation for this run only (INVARIANT-18).",
            "type": "object",
            "required": [
              "decisionRef",
              "scope",
              "runId"
            ],
            "properties": {
              "decisionRef": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "scope": {
                "const": "run"
              },
              "runId": {
                "$ref": "common.schema.json#/$defs/runId"
              }
            },
            "additionalProperties": false
          },
          "policyRef": {
            "$ref": "common.schema.json#/$defs/policyRef"
          },
          "confirmation": {
            "description": "v1.7 DEC-09: how the user confirmed a prefilled list row",
            "enum": [
              "prefilled_confirmed",
              "user_modified",
              "user_filled"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "answer": {
                  "type": "string"
                }
              }
            },
            "then": {
              "properties": {
                "decidedAt": {
                  "$ref": "common.schema.json#/$defs/dateTime"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "const": "answered"
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pending",
                    "skipped"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "null"
                }
              }
            }
          },
          {
            "description": "DEC-07: a delegated answer is the recommendation, recorded as a user decision; no recommendation means skipped, never delegated.",
            "if": {
              "required": [
                "delegation"
              ]
            },
            "then": {
              "required": [
                "status"
              ],
              "properties": {
                "source": {
                  "const": "user"
                },
                "status": {
                  "const": "answered"
                },
                "recommendation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "description": "v1.7 DEC-06: product_policy decisions need a resolvable policyRef",
            "if": {
              "required": [
                "source"
              ],
              "properties": {
                "source": {
                  "const": "product_policy"
                }
              }
            },
            "then": {
              "required": [
                "policyRef"
              ]
            }
          }
        ]
      }
    },
    "accessibilityPrecheck": {
      "description": "v1.4 §9.5: contrast / target-size check of the patterns and styles the plan will reuse, done before Build.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "subject",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "kind": {
            "enum": [
              "text_contrast",
              "non_text_contrast",
              "target_size"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "styleName": {
            "type": "string"
          },
          "sourceNodeIds": {
            "$ref": "common.schema.json#/$defs/nodeIds"
          },
          "foreground": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "background": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "fontSize": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bold": {
            "type": "boolean"
          },
          "ratio": {
            "type": "number",
            "minimum": 1
          },
          "required": {
            "type": "number",
            "minimum": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_verified"
            ]
          },
          "baselineRef": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "decisionRef": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "fail"
                }
              }
            },
            "then": {
              "required": [
                "decisionRef"
              ]
            }
          }
        ]
      }
    },
    "scope": {
      "type": "object"
    },
    "baseline": {
      "type": "object",
      "required": [
        "observations"
      ],
      "properties": {
        "pagesBefore": {
          "$ref": "common.schema.json#/$defs/nodeIds"
        },
        "screenshots": {
          "$ref": "common.schema.json#/$defs/refs"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "subject"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "kind": {
                "enum": [
                  "inherited_baseline",
                  "regression_risk",
                  "note"
                ]
              },
              "subject": {
                "type": "string"
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "flow": {
      "description": "v1.6 (A04): on-demand flow judgement. level=unchanged keeps the existing flow (reason says why no flow work is needed); partial adds the local steps that change; task_flow lays out the whole task. Unknown business rules stay as open unknowns and are never filled in by the agent.",
      "type": "object",
      "required": [
        "level",
        "reason",
        "sources",
        "status"
      ],
      "properties": {
        "level": {
          "enum": [
            "unchanged",
            "partial",
            "task_flow"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "description": "Where the flow comes from. Empty only for level=unchanged; never invent a source.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "brief",
                  "user",
                  "pattern",
                  "reference_node",
                  "decision"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "status": {
          "enum": [
            "pending",
            "confirmed"
          ]
        },
        "confirmedBy": {
          "description": "brief: the request itself fixes the flow (for example a local style change); user: needs decisionRef.",
          "enum": [
            "brief",
            "user"
          ]
        },
        "decisionRef": {
          "$ref": "common.schema.json#/$defs/localId"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "action",
              "result",
              "screenKey"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "entry": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              },
              "screenKey": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "branches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "condition",
                    "to"
                  ],
                  "properties": {
                    "condition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "$ref": "common.schema.json#/$defs/localId"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "end": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "status"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/localId"
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "open",
                  "answered"
                ]
              },
              "answer": {
                "type": "string"
              },
              "decisionRef": {
                "$ref": "common.schema.json#/$defs/localId"
              }
            },
            "additionalProperties": false,
            "if": {
              "properties": {
                "status": {
                  "const": "answered"
                }
              }
            },
            "then": {
              "required": [
                "answer",
                "decisionRef"
              ]
            }
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "enum": [
                  "partial",
                  "task_flow"
                ]
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ],
            "properties": {
              "steps": {
                "minItems": 1
              },
              "sources": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "confirmedBy"
            ],
            "properties": {
              "confirmedBy": {
                "const": "user"
              }
            }
          },
          "then": {
            "required": [
              "decisionRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "required": [
              "confirmedBy"
            ]
          }
        }
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision",
          "scope",
          "decidedAt",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "decision": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "decidedAt": {
            "$ref": "common.schema.json#/$defs/dateTime"
          },
          "source": {
            "enum": [
              "user"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "policyRef": {
            "$ref": "common.schema.json#/$defs/policyRef"
